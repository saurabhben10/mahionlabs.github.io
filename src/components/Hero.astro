---
import { siteConfig } from '../config/site';
import Button from './Button.astro';
---

<section class="relative pt-16 pb-20 md:pt-28 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
      
      <!-- Studio Eyebrow Pill -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-medium text-zinc-300 bg-white/[0.04] border border-white/[0.08] backdrop-blur-md mb-8">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        <span class="font-medium text-zinc-200">Independent Software Studio</span>
        <span class="text-zinc-600">/</span>
        <span class="text-zinc-400">Mobile & Intelligent Tools</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.1] sm:leading-[1.12]">
        Building useful software for <span class="text-gradient">what comes next.</span>
      </h1>

      <!-- Supporting Description -->
      <p class="mt-6 md:mt-8 text-base sm:text-lg md:text-xl text-zinc-400 max-w-2xl leading-relaxed font-normal">
        Mahion Labs is an independent software studio creating practical mobile applications, AI-powered tools, productivity software and digital products designed to solve real problems.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-8 md:mt-10 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <Button href="/apps" variant="primary" size="lg" className="w-full sm:w-auto">
          <span>Explore Our Apps</span>
          <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </Button>

        <Button href="/about" variant="secondary" size="lg" className="w-full sm:w-auto">
          <span>About Mahion Labs</span>
        </Button>
      </div>

      <!-- Trust Badges & Technical Indicators -->
      <div class="mt-14 pt-8 border-t border-white/[0.06] w-full max-w-xl grid grid-cols-3 gap-4 text-center">
        <div class="space-y-1">
          <div class="text-xs font-semibold text-zinc-200">Google Play</div>
          <div class="text-[11px] text-zinc-400">Verified Developer</div>
        </div>
        <div class="space-y-1 border-x border-white/[0.06]">
          <div class="text-xs font-semibold text-zinc-200">Architecture</div>
          <div class="text-[11px] text-zinc-400">Offline-First & Fast</div>
        </div>
        <div class="space-y-1">
          <div class="text-xs font-semibold text-zinc-200">Data Policy</div>
          <div class="text-[11px] text-zinc-400">Privacy by Design</div>
        </div>
      </div>

    </div>
  </div>
</section>
