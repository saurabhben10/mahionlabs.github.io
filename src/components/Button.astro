---
import { formatUrl } from '../config/site';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'subtle' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  className?: string;
  target?: string;
  rel?: string;
  id?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  className = '',
  target,
  rel,
  id,
  'aria-label': ariaLabel,
} = Astro.props;

const finalHref = href ? formatUrl(href) : undefined;

const baseStyles = "inline-flex items-center justify-center font-medium rounded-xl transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-dark-950 select-none group cursor-pointer";

const sizeStyles = {
  sm: "px-3.5 py-1.5 text-xs gap-1.5",
  md: "px-5 py-2.5 text-sm gap-2",
  lg: "px-6 py-3.5 text-base gap-2.5",
};

const variantStyles = {
  primary: "bg-white text-dark-950 font-semibold hover:bg-zinc-200 active:scale-[0.98] shadow-sm border border-white",
  secondary: "bg-white/[0.05] text-zinc-200 hover:text-white hover:bg-white/[0.09] border border-white/[0.1] hover:border-white/[0.2] active:scale-[0.98]",
  outline: "bg-transparent text-zinc-300 hover:text-white border border-zinc-700 hover:border-zinc-500 hover:bg-white/[0.04]",
  subtle: "bg-transparent text-zinc-400 hover:text-white hover:bg-white/[0.05]",
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  finalHref ? (
    <a href={finalHref} class={classes} target={target} rel={rel} aria-label={ariaLabel} id={id}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} id={id}>
      <slot />
    </button>
  )
}
