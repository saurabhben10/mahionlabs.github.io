---
import { formatUrl } from '../config/site';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'subtle' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  className?: string;
  target?: string;
  rel?: string;
  id?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  className = '',
  target,
  rel,
  id,
  'aria-label': ariaLabel,
} = Astro.props;

const finalHref = href ? formatUrl(href) : undefined;

const baseStyles = "inline-flex items-center justify-center font-medium rounded-xl transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-paper-100 select-none group cursor-pointer";

const sizeStyles = {
  sm: "px-3.5 py-1.5 text-xs gap-1.5",
  md: "px-5 py-2.5 text-sm gap-2",
  lg: "px-6 py-3.5 text-base gap-2.5",
};

const variantStyles = {
  primary: "bg-ink-950 text-white font-semibold hover:bg-ink-800 active:scale-[0.98] shadow-sm border border-ink-950",
  secondary: "bg-white text-ink-900 hover:bg-paper-200 hover:text-ink-950 border border-ink-950/10 hover:border-ink-950/25 active:scale-[0.98] shadow-subtle",
  outline: "bg-transparent text-ink-800 hover:text-ink-950 border border-ink-950/20 hover:border-ink-950/40 hover:bg-black/[0.03]",
  subtle: "bg-transparent text-ink-600 hover:text-ink-950 hover:bg-black/[0.04]",
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  finalHref ? (
    <a href={finalHref} class={classes} target={target} rel={rel} aria-label={ariaLabel} id={id}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} id={id}>
      <slot />
    </button>
  )
}
