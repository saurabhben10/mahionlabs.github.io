---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'subtle' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  className?: string;
  target?: string;
  rel?: string;
  id?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  className = '',
  target,
  rel,
  id,
  'aria-label': ariaLabel,
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-medium rounded-xl transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-dark-950 select-none group cursor-pointer";

const sizeStyles = {
  sm: "px-3.5 py-1.5 text-xs gap-1.5",
  md: "px-5 py-2.5 text-sm gap-2",
  lg: "px-6 py-3.5 text-base gap-2.5 shadow-lg",
};

const variantStyles = {
  primary: "bg-gradient-to-r from-brand-600 via-brand-500 to-indigo-600 text-white hover:from-brand-500 hover:to-indigo-500 shadow-glow-sm hover:shadow-glow-md border border-brand-400/30 active:scale-[0.98]",
  secondary: "bg-white/[0.06] text-white hover:bg-white/[0.1] border border-white/[0.12] hover:border-white/[0.25] active:scale-[0.98]",
  outline: "bg-transparent text-slate-300 hover:text-white border border-slate-700 hover:border-slate-500 hover:bg-white/[0.04]",
  subtle: "bg-transparent text-slate-400 hover:text-white hover:bg-white/[0.05]",
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} aria-label={ariaLabel} id={id}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} id={id}>
      <slot />
    </button>
  )
}
