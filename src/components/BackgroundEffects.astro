---
---

<div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
  <!-- Subtle Technical Grid -->
  <div class="absolute inset-0 subtle-grid opacity-35 mask-gradient"></div>

  <!-- Ambient Glowing Radial Spheres -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-brand-500/10 rounded-full blur-[120px]"></div>
  <div class="absolute top-[35%] -right-40 w-[500px] h-[450px] bg-cyan-500/05 rounded-full blur-[130px]"></div>
  <div class="absolute bottom-10 -left-40 w-[600px] h-[500px] bg-brand-600/08 rounded-full blur-[140px]"></div>

  <!-- Delicate Geometric / Orbital Accent Rings -->
  <svg class="absolute top-20 right-[-10%] w-[650px] h-[650px] opacity-[0.04]" viewBox="0 0 100 100" fill="none">
    <circle cx="50" cy="50" r="45" stroke="#FFFFFF" stroke-width="0.5" stroke-dasharray="3 6" />
    <circle cx="50" cy="50" r="30" stroke="#6C7CFF" stroke-width="0.5" />
    <circle cx="50" cy="50" r="15" stroke="#38BDF8" stroke-width="0.5" stroke-dasharray="1 3" />
  </svg>
</div>

<style>
  .mask-gradient {
    mask-image: radial-gradient(circle at 50% 30%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 30%, black 20%, transparent 80%);
  }
</style>
