  <!-- Warm Minimalist Ambient Vignette (Zero neon / purple) -->
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-white/[0.025] rounded-full blur-[140px]"></div>
  <div class="absolute bottom-0 right-10 w-[600px] h-[400px] bg-white/[0.015] rounded-full blur-[150px]"></div>
</div>

<style>
  .mask-gradient {
    mask-image: radial-gradient(circle at 50% 25%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 25%, black 20%, transparent 80%);
  }
</style>
