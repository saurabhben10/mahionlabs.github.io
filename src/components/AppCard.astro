---
import type { AppProduct } from '../types';
import Button from './Button.astro';
import { formatUrl } from '../config/site';

interface Props {
  app: AppProduct;
  featured?: boolean;
}

const { app, featured = false } = Astro.props;

const statusConfig = {
  'released': { label: 'Available Now', dot: 'bg-emerald-500', badge: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
  'beta': { label: 'Public Beta', dot: 'bg-cyan-500', badge: 'bg-cyan-50 text-cyan-800 border-cyan-200' },
  'coming-soon': { label: 'Active Development', dot: 'bg-gold-400', badge: 'bg-gold-50 text-gold-700 border-gold-200' },
  'in-development': { label: 'In Development', dot: 'bg-amber-500', badge: 'bg-amber-50 text-amber-800 border-amber-200' },
};

const currentStatus = statusConfig[app.status] || statusConfig['coming-soon'];
---

<div class={`glass-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden transition-all duration-200 border ${
  featured ? 'border-black/[0.09] bg-white shadow-subtle' : 'border-black/[0.06]'
}`}>
  <div>
    <!-- Header: App Icon + Status Badge -->
    <div class="flex items-start justify-between gap-4 mb-6">
      <div class="w-12 h-12 rounded-2xl bg-paper-200 border border-black/[0.06] p-2.5 flex items-center justify-center text-ink-900 shadow-xs flex-shrink-0">
        <!-- Default App Glyph -->
        <svg class="w-6 h-6 text-ink-800" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
      </div>

      <div class="flex flex-col items-end gap-1.5">
        <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono font-medium border ${currentStatus.badge}`}>
          <span class={`w-1.5 h-1.5 rounded-full ${currentStatus.dot}`}></span>
          <span>{currentStatus.label}</span>
        </span>
        {app.category && (
          <span class="text-[11px] text-ink-500 font-mono">
            {app.category}
          </span>
        )}
      </div>
    </div>

    <!-- Title & Description -->
    <h3 class="text-xl font-bold text-ink-950 mb-2 group-hover:text-gold-600 transition-colors">
      <a href={formatUrl(`/apps/${app.slug}`)} class="hover:underline focus-visible:outline-none">
        {app.name}
      </a>
    </h3>
    
    <p class="text-sm text-ink-600 mb-5 leading-relaxed line-clamp-3 font-normal">
      {app.description}
    </p>

    <!-- Key Features Snippet -->
    {app.features && app.features.length > 0 && (
      <ul class="space-y-2 mb-6 text-xs text-ink-600">
        {app.features.slice(0, 2).map((feature) => (
          <li class="flex items-start gap-2.5">
            <svg class="w-3.5 h-3.5 text-gold-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Footer Actions & Links -->
  <div class="pt-5 border-t border-black/[0.06] flex flex-col gap-3">
    <div class="flex items-center gap-2">
      {app.playStoreUrl ? (
        <Button href={app.playStoreUrl} target="_blank" rel="noopener noreferrer" variant="primary" size="sm" className="w-full">
          <svg class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a1.996 1.996 0 01-.61-1.428V3.242c0-.55.225-1.05.609-1.428zm11.606 11.608L5.65 21.056l10.222-5.902-1.657-1.732zM17.307 10.97l2.845 1.643a1.238 1.238 0 010 2.146l-2.845 1.643-2.029-2.028 2.029-2.404zm-2.092-2.092L5.65 2.944l9.565 7.634 1.732-1.7z"/>
          </svg>
          Google Play
        </Button>
      ) : (
        <Button href={`/apps/${app.slug}`} variant="secondary" size="sm" className="w-full">
          <span>View Details</span>
          <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </Button>
      )}
    </div>

    <!-- Quick Meta Links (Privacy, Support) -->
    <div class="flex items-center justify-between text-xs text-ink-500 px-1 font-mono">
      <a href={formatUrl(app.privacyPolicyUrl)} class="hover:text-ink-950 transition-colors">
        Privacy Policy
      </a>
      <span class="text-ink-300">•</span>
      <a href={formatUrl(app.supportUrl)} class="hover:text-ink-950 transition-colors">
        App Support
      </a>
    </div>
  </div>
</div>
