---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showText?: boolean;
  className?: string;
}

const { size = 'md', showText = true, className = '' } = Astro.props;

const dimensions = {
  sm: { icon: 'w-6 h-6', text: 'text-base font-semibold' },
  md: { icon: 'w-8 h-8', text: 'text-lg font-bold' },
  lg: { icon: 'w-10 h-10', text: 'text-xl font-bold' },
  xl: { icon: 'w-14 h-14', text: 'text-2xl font-extrabold' },
};
---

<div class={`inline-flex items-center gap-3 select-none group ${className}`}>
  <!-- Vector SVG Logo: Classy Architectural Geometric 'F' Motif in Deep Ink & Gold -->
  <div class={`relative ${dimensions[size].icon} flex items-center justify-center`}>
    <div class="absolute inset-0 bg-ink-950/[0.04] rounded-xl group-hover:bg-gold-400/[0.12] transition-colors duration-200"></div>
    <svg 
      viewBox="0 0 40 40" 
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-full relative z-10"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="flipedy-ink-grad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
          <stop stop-color="#121316" />
          <stop offset="0.7" stop-color="#282B33" />
          <stop offset="1" stop-color="#B48B22" />
        </linearGradient>
      </defs>
      
      <!-- Outer Precision Border -->
      <rect 
        x="5" 
        y="5" 
        width="30" 
        height="30" 
        rx="8" 
        stroke="rgba(18, 19, 22, 0.15)" 
        stroke-width="1.25" 
      />

      <!-- Architectural 'F' Path with Flip Horizon -->
      <path 
        d="M14 27V13H26M14 20H23" 
        stroke="url(#flipedy-ink-grad)" 
        stroke-width="2.5" 
        stroke-linecap="round" 
        stroke-linejoin="round"
      />

      <!-- Gold Precision Accent Node -->
      <circle 
        cx="26" 
        cy="13" 
        r="2" 
        fill="#B48B22" 
      />
    </svg>
  </div>

  {showText && (
    <span class={`tracking-tight text-ink-950 group-hover:text-gold-500 transition-colors duration-200 ${dimensions[size].text}`}>
      Flipedy <span class="font-normal text-ink-600">Labs</span>
    </span>
  )}
</div>
