---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showText?: boolean;
  className?: string;
}

const { size = 'md', showText = true, className = '' } = Astro.props;

const dimensions = {
  sm: { icon: 'w-6 h-6', text: 'text-base font-semibold' },
  md: { icon: 'w-8 h-8', text: 'text-lg font-bold' },
  lg: { icon: 'w-10 h-10', text: 'text-xl font-bold' },
  xl: { icon: 'w-14 h-14', text: 'text-2xl font-extrabold' },
};
---

<div class={`inline-flex items-center gap-3 select-none group ${className}`}>
  <!-- Vector SVG Logo: Minimalist Geometric Architectural 'M' Motif -->
  <div class={`relative ${dimensions[size].icon} flex items-center justify-center`}>
    <div class="absolute inset-0 bg-white/[0.04] rounded-xl group-hover:bg-white/[0.08] transition-colors duration-200"></div>
    <svg 
      viewBox="0 0 40 40" 
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-full relative z-10"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="mahion-mono-grad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FFFFFF" />
          <stop offset="0.7" stop-color="#D4D4D8" />
          <stop offset="1" stop-color="#71717A" />
        </linearGradient>
      </defs>
      
      <!-- Outer Precision Border -->
      <rect 
        x="5" 
        y="5" 
        width="30" 
        height="30" 
        rx="8" 
        stroke="rgba(255,255,255,0.12)" 
        stroke-width="1.25" 
      />

      <!-- Dynamic Architectural 'M' Path -->
      <path 
        d="M11 26V14L20 22L29 14V26" 
        stroke="url(#mahion-mono-grad)" 
        stroke-width="2.5" 
        stroke-linecap="round" 
        stroke-linejoin="round"
      />

      <!-- Minimalist Node Accent -->
      <circle 
        cx="20" 
        cy="22" 
        r="2" 
        fill="#FFFFFF" 
      />
    </svg>
  </div>

  {showText && (
    <span class={`tracking-tight text-white group-hover:text-zinc-300 transition-colors duration-200 ${dimensions[size].text}`}>
      Mahion <span class="font-normal text-zinc-400">Labs</span>
    </span>
  )}
</div>
