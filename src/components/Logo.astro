---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showText?: boolean;
  className?: string;
}

const { size = 'md', showText = true, className = '' } = Astro.props;

const dimensions = {
  sm: { icon: 'w-6 h-6', text: 'text-base font-semibold' },
  md: { icon: 'w-8 h-8', text: 'text-lg font-bold' },
  lg: { icon: 'w-10 h-10', text: 'text-xl font-bold' },
  xl: { icon: 'w-14 h-14', text: 'text-2xl font-extrabold' },
};
---

<div class={`inline-flex items-center gap-3 select-none group ${className}`}>
  <!-- Vector SVG Logo: Abstract Forward-Moving Orbital 'M' -->
  <div class={`relative ${dimensions[size].icon} flex items-center justify-center`}>
    <div class="absolute inset-0 bg-brand-500/20 rounded-xl blur-sm group-hover:bg-brand-500/35 transition-colors duration-300"></div>
    <svg 
      viewBox="0 0 40 40" 
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-full relative z-10 drop-shadow-[0_2px_8px_rgba(108,124,255,0.4)]"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="mahion-grad-primary" x1="4" y1="4" x2="36" y2="36" gradientUnits="userSpaceOnUse">
          <stop stop-color="#38BDF8" />
          <stop offset="0.5" stop-color="#6C7CFF" />
          <stop offset="1" stop-color="#A855F7" />
        </linearGradient>
        <linearGradient id="mahion-grad-node" x1="0" y1="0" x2="1" y2="1">
          <stop stop-color="#38BDF8" />
          <stop offset="1" stop-color="#6C7CFF" />
        </linearGradient>
        <filter id="glow-node" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="1.5" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>
      
      <!-- Outer Hexagonal/Orbital Track -->
      <path 
        d="M20 4L34 12V28L20 36L6 28V12L20 4Z" 
        stroke="rgba(255,255,255,0.12)" 
        stroke-width="1.5" 
        stroke-dasharray="2 4"
      />

      <!-- Dynamic Abstract 'M' Geometric Path -->
      <path 
        d="M10 27V15L20 23L30 15V27" 
        stroke="url(#mahion-grad-primary)" 
        stroke-width="3" 
        stroke-linecap="round" 
        stroke-linejoin="round"
      />

      <!-- Forward Velocity / Orbit Beam -->
      <path 
        d="M14 11L20 6L26 11" 
        stroke="#38BDF8" 
        stroke-width="2" 
        stroke-linecap="round" 
        stroke-linejoin="round"
        opacity="0.85"
      />

      <!-- Connected Central Energy Node (Ion) -->
      <circle 
        cx="20" 
        cy="23" 
        r="2.75" 
        fill="#FFFFFF" 
        stroke="#6C7CFF" 
        stroke-width="1.5"
        filter="url(#glow-node)"
      />
    </svg>
  </div>

  {showText && (
    <span class={`tracking-tight text-white group-hover:text-brand-300 transition-colors duration-200 ${dimensions[size].text}`}>
      Mahion <span class="font-normal text-slate-400">Labs</span>
    </span>
  )}
</div>
