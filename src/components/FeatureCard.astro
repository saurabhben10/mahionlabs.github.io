---
interface Props {
  title: string;
  description: string;
  iconName?: string;
  index?: number;
}

const { title, description, iconName = 'sparkles', index = 0 } = Astro.props;
---

<div class="glass-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden group">
  <div>
    <!-- Minimalist Icon Container -->
    <div class="w-11 h-11 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-zinc-300 mb-6 group-hover:bg-white/[0.08] group-hover:border-white/[0.18] transition-all duration-200">
      {iconName === 'target' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="10" stroke-width="1.5" />
          <circle cx="12" cy="12" r="6" stroke-width="1.5" />
          <circle cx="12" cy="12" r="2" stroke-width="1.5" fill="currentColor" />
        </svg>
      )}
      {iconName === 'sparkles' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      )}
      {iconName === 'refresh-cw' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
      )}
      {iconName === 'user-check' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      )}
    </div>

    <!-- Title & Description -->
    <h3 class="text-base font-semibold text-white mb-2 group-hover:text-zinc-100 transition-colors">
      {title}
    </h3>
    <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed font-normal">
      {description}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-white/[0.04] flex items-center justify-between text-xs text-zinc-500 font-mono">
    <span>0{index + 1}</span>
    <span class="text-zinc-600 group-hover:text-zinc-400 transition-colors">Principle</span>
  </div>
</div>
