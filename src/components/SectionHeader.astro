---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  className?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  className = ''
} = Astro.props;

const alignmentClasses = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
---

<div class={`flex flex-col max-w-3xl ${alignmentClasses} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-medium tracking-wider uppercase text-gold-600 bg-gold-50 border border-gold-200 mb-3 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
      <span>{eyebrow}</span>
    </div>
  )}
  
  <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-ink-950">
    {title}
  </h2>
  
  {description && (
    <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed max-w-2xl font-normal">
      {description}
    </p>
  )}
</div>
