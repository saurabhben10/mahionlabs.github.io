---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import { siteConfig, studioPrinciples } from '../config/site';
---

<BaseLayout
  title="About Flipedy Labs"
  description="Flipedy Labs is an independent software studio building practical mobile applications, AI-powered tools and modern digital products."
>
  <div class="py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <SectionHeader
      eyebrow="Studio Profile"
      title="About Flipedy Labs"
      description="An independent software studio building practical applications, intelligent tools and modern digital products."
    />

    <!-- Main Story & Focus -->
    <div class="mt-14 space-y-8">
      <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/[0.08] relative overflow-hidden space-y-6">
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
          Crafting tools designed to solve real problems.
        </h2>

        <p class="text-base text-zinc-300 leading-relaxed font-normal">
          Flipedy Labs is an independent software studio focused on building practical applications, intelligent tools and useful digital products. We experiment quickly, learn from real-world usage and continuously improve the products we create.
        </p>

        <p class="text-base text-zinc-300 leading-relaxed font-normal">
          Our interests span mobile applications, artificial intelligence, automation, productivity and emerging technologies. Rather than building bloated software or chasing trends, we focus on thoughtful engineering that produces genuine utility.
        </p>

        <div class="p-6 rounded-2xl bg-white/[0.03] border-l-2 border-champagne-400 my-6">
          <p class="text-base text-zinc-100 font-medium italic leading-relaxed">
            “We believe the best technology often disappears into the experience — solving the problem without adding unnecessary complexity.”
          </p>
        </div>

        <p class="text-sm text-zinc-400 leading-relaxed font-normal">
          Every app published under the Flipedy Labs banner is held to rigorous standards: zero intrusive ad tracking, transparent privacy guidelines, and robust offline-first functionality wherever applicable.
        </p>
      </div>

      <!-- Studio Focus Areas Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card rounded-2xl p-6 sm:p-8">
          <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] text-champagne-300 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Mobile Applications</h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-normal">
            High-performance native and cross-platform apps built for Android and modern mobile platforms with fluid UX.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-6 sm:p-8">
          <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] text-champagne-300 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Intelligent Automation</h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-normal">
            Applying machine intelligence strictly where it reduces human friction and simplifies repetitive routines.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-6 sm:p-8">
          <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] text-champagne-300 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Privacy & Reliability</h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-normal">
            Local-first storage paradigms, resilient architecture, and zero compromise on data security.
          </p>
        </div>
      </div>

      <!-- Principles List -->
      <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/[0.08] space-y-6">
        <h2 class="text-xl font-bold text-white tracking-tight">Our Development Principles</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
          {studioPrinciples.map((item, idx) => (
            <div class="space-y-2">
              <div class="text-xs font-mono text-champagne-400">0{idx + 1}</div>
              <h3 class="text-sm font-semibold text-white">{item.title}</h3>
              <p class="text-xs text-zinc-400 leading-relaxed font-normal">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Developer Credentials and Contact CTA -->
      <div class="p-8 rounded-3xl bg-dark-900/90 border border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-base font-bold text-white">Google Play Verified Developer</h3>
          <p class="text-xs text-zinc-400 mt-1 font-mono">Official developer identity: <span class="text-zinc-200 font-medium">{siteConfig.developerName}</span></p>
        </div>
        <div class="flex items-center gap-3">
          <Button href="/apps" variant="primary" size="sm">
            View Applications
          </Button>
          <Button href="/support" variant="secondary" size="sm">
            Contact Us
          </Button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
