---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import CopyButton from '../components/CopyButton.astro';
import { siteConfig } from '../config/site';

const faqs = [
  {
    q: 'How do I report a bug or unexpected behavior in an app?',
    a: `Please send an email to ${siteConfig.email} with the app name, your device model, OS version (e.g., Android 14), and a brief description of what happened, including any steps to reproduce the issue.`
  },
  {
    q: 'How do I request a refund for a Google Play in-app purchase?',
    a: 'Google Play purchases are processed directly through Google Play billing. You can request refunds via your Google Play order history or by contacting us with your Google Play Order ID (GPA.XXXX-XXXX-XXXX-XXXXX).'
  },
  {
    q: 'How do I submit feature suggestions or product feedback?',
    a: `We welcome user suggestions. Reach out directly to ${siteConfig.email} with your ideas or workflow requirements.`
  },
  {
    q: 'Where can I review how my data is handled?',
    a: 'You can review our General Privacy Policy at /privacy, or view app-specific disclosures linked from the individual app page or in-app settings.'
  }
];
---

<BaseLayout
  title="Support & Help Center — Flipedy Labs"
  description="Get help, report issues, and find support for all apps and software published by Flipedy Labs."
>
  <div class="py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Page Header -->
    <SectionHeader
      eyebrow="Help & Assistance"
      title="How can we help?"
      description="We're here to ensure you have a seamless experience with all software products developed by Flipedy Labs."
    />

    <!-- Product Support Main Card -->
    <div class="mt-14 glass-panel rounded-3xl p-8 sm:p-12 border border-black/[0.08] bg-white relative overflow-hidden shadow-subtle">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-mono font-medium tracking-wider uppercase text-gold-700 bg-gold-50 border border-gold-200">
          <span>Product Support</span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-bold text-ink-950 tracking-tight">
          Direct Developer Support
        </h2>

        <p class="text-base text-ink-700 leading-relaxed font-normal">
          If you’re experiencing an issue with one of our applications, please include the app name, device information and a brief description of the issue when contacting us.
        </p>

        <!-- Guidelines Checklist -->
        <div class="p-5 rounded-2xl bg-paper-100 border border-black/[0.06] space-y-3">
          <h3 class="text-xs font-mono font-medium text-ink-800 uppercase tracking-wider">Helpful details to include:</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-ink-600 font-normal">
            <li class="flex items-center gap-2 p-2.5 rounded-lg bg-white border border-black/[0.05] shadow-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
              <span>1. Application Name & Version</span>
            </li>
            <li class="flex items-center gap-2 p-2.5 rounded-lg bg-white border border-black/[0.05] shadow-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
              <span>2. Device Model & OS Version</span>
            </li>
            <li class="flex items-center gap-2 p-2.5 rounded-lg bg-white border border-black/[0.05] shadow-xs">
              <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
              <span>3. Description or Screenshots</span>
            </li>
          </ul>
        </div>

        <!-- Contact Actions Box -->
        <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-6 rounded-2xl bg-paper-100 border border-black/[0.06]">
          <div class="space-y-1">
            <div class="text-xs text-ink-500 uppercase tracking-wider font-mono">Official Contact Email</div>
            <a href={`mailto:${siteConfig.email}`} class="text-lg sm:text-xl font-bold text-ink-950 hover:text-gold-600 hover:underline">
              {siteConfig.email}
            </a>
            <div class="text-xs text-ink-600 font-mono">Developer: <span class="text-ink-950 font-medium">{siteConfig.developerName}</span></div>
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto">
            <Button href={`mailto:${siteConfig.email}`} variant="primary" size="md" className="flex-1 sm:flex-none">
              <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Email Support</span>
            </Button>
            <CopyButton textToCopy={siteConfig.email} label="Copy Email" />
          </div>
        </div>
      </div>
    </div>

    <!-- Frequently Asked Questions -->
    <div class="mt-16 space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-ink-950 tracking-tight text-center">
        Frequently Asked Questions
      </h2>

      <div class="grid grid-cols-1 gap-4 max-w-3xl mx-auto">
        {faqs.map((faq, idx) => (
          <div class="glass-card rounded-2xl p-6 bg-white border border-black/[0.07] space-y-2 shadow-subtle">
            <h3 class="text-base font-semibold text-ink-950 flex items-start gap-3">
              <span class="text-gold-500 font-mono text-sm">0{idx + 1}.</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-sm text-ink-600 pl-8 leading-relaxed font-normal">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
