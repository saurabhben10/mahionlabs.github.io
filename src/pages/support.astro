---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import CopyButton from '../components/CopyButton.astro';
import { siteConfig } from '../config/site';

const faqs = [
  {
    q: 'How do I report a bug or unexpected behavior in an app?',
    a: `Please send an email to ${siteConfig.email} with the app name, your device model, OS version (e.g., Android 14), and a brief description of what happened, including any steps to reproduce the issue.`
  },
  {
    q: 'How do I request a refund for a Google Play in-app purchase?',
    a: 'Google Play purchases are processed directly through Google Play billing. You can request refunds via your Google Play order history or by contacting us with your Google Play Order ID (GPA.XXXX-XXXX-XXXX-XXXXX).'
  },
  {
    q: 'How do I submit feature suggestions or product feedback?',
    a: `We welcome user suggestions. Reach out directly to ${siteConfig.email} with your ideas or workflow requirements.`
  },
  {
    q: 'Where can I review how my data is handled?',
    a: 'You can review our General Privacy Policy at /privacy, or view app-specific disclosures linked from the individual app page or in-app settings.'
  }
];
---

<BaseLayout
  title="Support & Help Center — Mahion Labs"
  description="Get help, report issues, and find support for all apps and software published by Mahion Labs."
>
  <div class="py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Page Header -->
    <SectionHeader
      eyebrow="Help & Assistance"
      title="How can we help?"
      description="We're here to ensure you have a seamless experience with all software products developed by Mahion Labs."
    />

    <!-- Product Support Main Card -->
    <div class="mt-14 glass-panel rounded-3xl p-8 sm:p-12 border border-brand-500/25 relative overflow-hidden">
      <!-- Ambient Glow -->
      <div class="absolute -top-24 right-0 w-80 h-80 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-brand-300 bg-brand-500/15 border border-brand-500/30">
          <span>Product Support</span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Direct Developer Support
        </h2>

        <p class="text-base text-slate-300 leading-relaxed">
          If you’re experiencing an issue with one of our applications, please include the app name, device information and a brief description of the issue when contacting us.
        </p>

        <!-- Guidelines Checklist -->
        <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/[0.08] space-y-3">
          <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Helpful details to include:</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-slate-400">
            <li class="flex items-center gap-2 p-2.5 rounded-lg bg-dark-900/60 border border-white/[0.04]">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
              <span>1. Application Name & Version</span>
            </li>
            <li class="flex items-center gap-2 p-2.5 rounded-lg bg-dark-900/60 border border-white/[0.04]">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
              <span>2. Device Model & OS Version</span>
            </li>
            <li class="flex items-center gap-2 p-2.5 rounded-lg bg-dark-900/60 border border-white/[0.04]">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
              <span>3. Description or Screenshots</span>
            </li>
          </ul>
        </div>

        <!-- Contact Actions Box -->
        <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-6 rounded-2xl bg-dark-900/90 border border-white/[0.08]">
          <div class="space-y-1">
            <div class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Official Contact Email</div>
            <a href={`mailto:${siteConfig.email}`} class="text-lg sm:text-xl font-bold text-brand-300 hover:text-brand-200 hover:underline">
              {siteConfig.email}
            </a>
            <div class="text-xs text-slate-400">Developer: <span class="text-slate-200 font-medium">{siteConfig.developerName}</span></div>
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto">
            <Button href={`mailto:${siteConfig.email}`} variant="primary" size="md" className="flex-1 sm:flex-none">
              <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Email Support</span>
            </Button>
            <CopyButton textToCopy={siteConfig.email} label="Copy Email" />
          </div>
        </div>
      </div>
    </div>

    <!-- Frequently Asked Questions -->
    <div class="mt-16 space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight text-center">
        Frequently Asked Questions
      </h2>

      <div class="grid grid-cols-1 gap-4 max-w-3xl mx-auto">
        {faqs.map((faq, idx) => (
          <div class="glass-card rounded-2xl p-6 border border-white/[0.06] space-y-2">
            <h3 class="text-base font-semibold text-white flex items-start gap-3">
              <span class="text-brand-400 font-mono text-sm">Q{idx + 1}.</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-sm text-slate-400 pl-8 leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
