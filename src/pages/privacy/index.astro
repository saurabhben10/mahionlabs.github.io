---
/**
 * NOTE FOR DEVELOPERS:
 * This Privacy Policy serves as the general developer privacy policy for Flipedy Labs
 * and is suitable for Google Play Console account registration.
 * 
 * IMPORTANT: Whenever a new application is released to production or changes its data
 * practices (e.g. adding advertising, analytics, authentication, or cloud sync), review
 * this policy and provide an app-specific privacy policy under /privacy/[slug].
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { siteConfig, formatUrl } from '../../config/site';
---

<BaseLayout
  title="Privacy Policy — Flipedy Labs"
  description="Official General Privacy Policy for Flipedy Labs mobile applications and software services."
>
  <div class="py-16 md:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <SectionHeader
      eyebrow="Legal & Data Governance"
      title="Privacy Policy"
      description={`General Privacy Policy for ${siteConfig.name} software and mobile applications.`}
    />

    <div class="mt-6 text-center text-xs text-zinc-400 font-mono">
      <span>Last updated: {siteConfig.privacyLastUpdated}</span>
      <span class="mx-2">•</span>
      <span>Developer: {siteConfig.developerName}</span>
    </div>

    <!-- Policy Content Document -->
    <div class="mt-12 glass-panel rounded-3xl p-8 sm:p-12 border border-white/[0.08] space-y-10 text-zinc-300 leading-relaxed text-sm sm:text-base font-normal">
      
      <!-- 1. Introduction -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">01.</span>
          <span>Introduction</span>
        </h2>
        <p>
          Welcome to {siteConfig.name} ("we", "our", or "us"). This Privacy Policy describes how we handle information across our mobile applications, software tools, and related digital services (collectively, the "Services").
        </p>
        <p>
          {siteConfig.name} is an independent software studio committed to creating useful, respectful, and transparent software. Because our applications serve varied purposes, data collection practices may differ significantly from one application to another. This policy outlines our baseline standards and explains how data is handled across our software ecosystem.
        </p>
      </section>

      <!-- 2. Information Our Applications May Collect -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">02.</span>
          <span>Information Our Applications May Collect</span>
        </h2>
        <p>
          We design our applications to minimize data collection. Depending on the specific application and its intended functionality, our apps may process the following types of information:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-zinc-400">
          <li>
            <strong class="text-zinc-200 font-medium">Local User Data:</strong> Content, preferences, schedules, files, or parameters you create or configure within an app. In most of our tools, this information is stored locally on your device and is not transmitted to external servers.
          </li>
          <li>
            <strong class="text-zinc-200 font-medium">Technical & Diagnostics Information:</strong> Non-personally identifiable technical telemetry, such as device model, operating system version, app version, language settings, and crash logs generated to debug and improve app stability.
          </li>
          <li>
            <strong class="text-zinc-200 font-medium">User Inquiries & Support Communications:</strong> Information you voluntarily provide when emailing our support desk, including your email address, message contents, and attached diagnostic screenshots.
          </li>
        </ul>
      </section>

      <!-- 3. How Information May Be Used -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">03.</span>
          <span>How Information May Be Used</span>
        </h2>
        <p>
          Any information processed by our applications is used solely for legitimate operational purposes:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-zinc-400">
          <li>To operate, maintain, and deliver the core features of the respective application.</li>
          <li>To diagnose crashes, resolve bugs, and optimize battery and system performance.</li>
          <li>To respond to user inquiries, technical support tickets, and feature requests.</li>
          <li>To comply with applicable legal obligations and app marketplace terms.</li>
        </ul>
      </section>

      <!-- 4. Third-Party Services -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">04.</span>
          <span>Third-Party Services</span>
        </h2>
        <p>
          Our applications may rely on trusted third-party infrastructure providers to facilitate app distribution, error logging, and standard system functionality. These services operate under their respective privacy policies:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-zinc-400">
          <li>
            <strong class="text-zinc-200 font-medium">Google Play Services:</strong> Used for core platform runtime, license verification, updates, and in-app billing. (<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-champagne-300 hover:text-white hover:underline">Google Privacy Policy</a>)
          </li>
          <li>
            <strong class="text-zinc-200 font-medium">GitHub Pages:</strong> Used for hosting this official documentation and website. (<a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer" class="text-champagne-300 hover:text-white hover:underline">GitHub Privacy Statement</a>)
          </li>
        </ul>
        <p class="text-xs text-zinc-400">
          We do not sell, rent, or trade your personal data to third parties or data brokers.
        </p>
      </section>

      <!-- 5. Data Security -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">05.</span>
          <span>Data Security</span>
        </h2>
        <p>
          We employ industry-standard technical measures to safeguard your information. When data is stored locally on your device, it is secured through operating system application sandboxing. When transmitting technical data or email correspondence, secure encrypted channels (HTTPS/TLS) are utilized.
        </p>
      </section>

      <!-- 6. Data Retention -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">06.</span>
          <span>Data Retention</span>
        </h2>
        <p>
          Local app data persists on your device until you clear application storage or uninstall the application. Support correspondence is retained only as long as necessary to resolve your technical query and assist with follow-ups.
        </p>
      </section>

      <!-- 7. Children’s Privacy -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">07.</span>
          <span>Children’s Privacy</span>
        </h2>
        <p>
          Our general applications and services are not directed to children under the age of 13 (or under 16 in the European Economic Area). We do not knowingly collect personal identifiable information from children. If you become aware that a child has provided us with personal information, please contact us at <a href={`mailto:${siteConfig.email}`} class="text-champagne-300 hover:text-white hover:underline">{siteConfig.email}</a> so we can take immediate corrective action.
        </p>
      </section>

      <!-- 8. Changes to This Privacy Policy -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">08.</span>
          <span>Changes to This Privacy Policy</span>
        </h2>
        <p>
          We may update this Privacy Policy from time to time to reflect changes in our applications, legal requirements, or developer operational standards. The "Last updated" date at the top of this document indicates the effective date of the latest revisions. Continued use of our applications following an update constitutes acceptance of the modified terms.
        </p>
      </section>

      <!-- 9. Contact Us -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">09.</span>
          <span>Contact</span>
        </h2>
        <p>
          If you have any questions, feedback, or privacy-related concerns regarding our applications or this policy, please reach out to:
        </p>
        <div class="p-4 rounded-xl bg-dark-900/90 border border-white/[0.08] space-y-1">
          <div class="font-semibold text-white">{siteConfig.developerName}</div>
          <div class="text-sm text-zinc-400">Email: <a href={`mailto:${siteConfig.email}`} class="text-champagne-300 hover:text-white hover:underline">{siteConfig.email}</a></div>
          <div class="text-sm text-zinc-400">Website: <a href={siteConfig.siteUrl} class="text-champagne-300 hover:text-white hover:underline">{siteConfig.siteUrl}</a></div>
        </div>
      </section>

      <!-- 10. App-Specific Privacy Policies -->
      <section class="space-y-4 pt-6 border-t border-white/[0.06]">
        <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-champagne-400 font-mono text-base">10.</span>
          <span>App-Specific Privacy Policies</span>
        </h2>
        <p>
          Where an individual application implements features requiring unique permissions (such as location, camera, or specific cloud sync), that application will provide a dedicated privacy policy. In the event of any conflict between this general policy and an app-specific privacy policy, the app-specific policy takes precedence.
        </p>
        
        <div class="pt-2">
          <h3 class="text-xs font-mono font-medium uppercase tracking-wider text-zinc-400 mb-3">Available App Policies:</h3>
          <ul class="space-y-2 text-sm font-mono">
            {siteConfig.apps.map((app) => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-champagne-400"></span>
                <a href={formatUrl(app.privacyPolicyUrl)} class="text-zinc-200 hover:text-champagne-300 hover:underline">
                  {app.name} Privacy Policy
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
