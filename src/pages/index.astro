---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureCard from '../components/FeatureCard.astro';
import AppCard from '../components/AppCard.astro';
import Button from '../components/Button.astro';
import { siteConfig, philosophyCards } from '../config/site';
---

<BaseLayout
  title="Mahion Labs — Software & Intelligent Products"
  description="Mahion Labs is an independent software studio building useful mobile applications, AI-powered tools and modern digital products."
>
  <!-- Hero Section -->
  <Hero />

  <!-- Product Philosophy Section -->
  <section class="py-20 md:py-28 relative border-t border-white/[0.06] bg-dark-900/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <SectionHeader
        eyebrow="Our Philosophy"
        title="Software should make things simpler."
        description="We build products around real problems rather than technology for technology’s sake. Our focus is on creating useful, intuitive and reliable software that helps people work smarter, automate repetitive tasks and get more value from technology."
      />

      <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {philosophyCards.map((card, index) => (
          <FeatureCard
            title={card.title}
            description={card.description}
            iconName={card.iconName}
            index={index}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <section class="py-20 md:py-28 relative border-t border-white/[0.06]" id="products">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <SectionHeader
        eyebrow="Portfolio Pipeline"
        title="Products from Mahion Labs"
        description="We’re building our first generation of applications. New products will appear here as they become available."
      />

      <!-- Coming Soon Active Spotlight -->
      <div class="mt-14 max-w-4xl mx-auto">
        <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-brand-500/25 relative overflow-hidden text-center flex flex-col items-center">
          <!-- Ambient Glow -->
          <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-96 h-48 bg-brand-500/15 rounded-full blur-3xl pointer-events-none"></div>

          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-brand-300 bg-brand-500/15 border border-brand-500/30 mb-6">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span>First Generation in Progress</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold text-white mb-4">
            New Applications Coming Soon
          </h3>

          <p class="text-base text-slate-300 max-w-xl mb-8 leading-relaxed">
            We’re actively developing our debut lineup of Android mobile utilities and intelligent automation tools. Explore our product catalog to preview upcoming releases.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4">
            <Button href="/apps" variant="primary" size="md">
              <span>View Product Catalog</span>
              <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </Button>
            <Button href="/about" variant="secondary" size="md">
              Learn About Our Process
            </Button>
          </div>
        </div>
      </div>

      <!-- App Card Grid Preview -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {siteConfig.apps.map((app) => (
          <AppCard app={app} featured={true} />
        ))}
      </div>
    </div>
  </section>

  <!-- Developer Credibility & Standards Section -->
  <section class="py-20 relative border-t border-white/[0.06] bg-dark-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase text-brand-300 bg-brand-500/10 border border-brand-500/20">
            <span>Engineering Discipline</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight leading-tight">
            Built for reliability, speed, and real-world utility.
          </h2>
          <p class="text-slate-400 leading-relaxed text-base">
            Every product released by Mahion Labs follows strict standards of software craftsmanship. We avoid excessive telemetry, eliminate bloated runtimes, and build software that feels responsive and durable.
          </p>
          <ul class="space-y-3 text-sm text-slate-300 pt-2">
            <li class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full bg-brand-500/20 text-brand-300 flex items-center justify-center flex-shrink-0">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Official Google Play Console verified developer standards.</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full bg-brand-500/20 text-brand-300 flex items-center justify-center flex-shrink-0">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Strict user data privacy protections and transparent policies.</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full bg-brand-500/20 text-brand-300 flex items-center justify-center flex-shrink-0">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Responsive developer support with direct resolution workflows.</span>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-6">
          <div class="glass-card rounded-2xl p-6 sm:p-8 border border-white/[0.08] relative">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-white/[0.06]">
              <div class="flex items-center gap-3">
                <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
                <span class="text-sm font-semibold text-white">Mahion Labs Core Values</span>
              </div>
              <span class="text-xs font-mono text-slate-500">v1.0</span>
            </div>

            <div class="space-y-4">
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                <h4 class="text-sm font-semibold text-brand-200 mb-1">Direct Problem Solving</h4>
                <p class="text-xs text-slate-400 leading-relaxed">
                  We build tools to solve concrete daily problems — from schedule management to automated workflows.
                </p>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                <h4 class="text-sm font-semibold text-brand-200 mb-1">Privacy by Architecture</h4>
                <p class="text-xs text-slate-400 leading-relaxed">
                  We do not harvest data for ad monetization. Data collection is minimal and app-specific.
                </p>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                <h4 class="text-sm font-semibold text-brand-200 mb-1">Modern Engineering</h4>
                <p class="text-xs text-slate-400 leading-relaxed">
                  Modern mobile stacks, clean native experiences, and fast performance on every device.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <section class="py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-brand-500/20 text-center relative overflow-hidden">
        <div class="max-w-2xl mx-auto space-y-6">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white tracking-tight">
            Have questions or need product support?
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Our team is available to assist with inquiries, bug reports, and feedback for all current and upcoming software products.
          </p>
          <div class="flex flex-wrap justify-center gap-4 pt-2">
            <Button href="/support" variant="primary" size="md">
              Contact Support
            </Button>
            <Button href="/privacy" variant="secondary" size="md">
              Review Privacy Disclosures
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
