---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { siteConfig } from '../../config/site';
import type { AppProduct } from '../../types';

export async function getStaticPaths() {
  return siteConfig.apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppProduct;
}

const { app } = Astro.props;

const statusConfig = {
  'released': { label: 'Available Now', color: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' },
  'beta': { label: 'Public Beta', color: 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30' },
  'coming-soon': { label: 'Coming Soon', color: 'bg-brand-500/15 text-brand-300 border-brand-500/30' },
  'in-development': { label: 'In Active Development', color: 'bg-amber-500/15 text-amber-300 border-amber-500/30' },
};

const currentStatus = statusConfig[app.status] || statusConfig['coming-soon'];
---

<BaseLayout
  title={`${app.name} — Mahion Labs`}
  description={app.description}
>
  <div class="py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/apps" class="hover:text-white transition-colors">Apps</a>
      <span>/</span>
      <span class="text-slate-200 font-medium">{app.name}</span>
    </nav>

    <!-- App Hero Header -->
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-white/[0.08] relative overflow-hidden">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-8 border-b border-white/[0.08]">
        <div class="flex items-center gap-5">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-gradient-to-br from-brand-600/40 to-cyan-500/30 border border-brand-400/40 p-4 flex items-center justify-center text-white shadow-lg flex-shrink-0">
            <svg class="w-12 h-12 text-brand-200" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
              <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">{app.name}</h1>
              <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${currentStatus.color}`}>
                {currentStatus.label}
              </span>
            </div>
            <p class="text-sm text-slate-400 font-medium">{app.category}</p>
          </div>
        </div>

        <!-- Store / Action CTA -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
          {app.playStoreUrl ? (
            <Button href={app.playStoreUrl} target="_blank" rel="noopener noreferrer" variant="primary" size="md">
              <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a1.996 1.996 0 01-.61-1.428V3.242c0-.55.225-1.05.609-1.428zm11.606 11.608L5.65 21.056l10.222-5.902-1.657-1.732zM17.307 10.97l2.845 1.643a1.238 1.238 0 010 2.146l-2.845 1.643-2.029-2.028 2.029-2.404zm-2.092-2.092L5.65 2.944l9.565 7.634 1.732-1.7z"/>
              </svg>
              Get on Google Play
            </Button>
          ) : (
            <div class="px-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-xs text-slate-300 flex items-center justify-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              <span>Available Soon on Google Play</span>
            </div>
          )}
          <Button href={app.supportUrl} variant="secondary" size="md">
            Get Support
          </Button>
        </div>
      </div>

      <!-- Overview & Features Grid -->
      <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-6">
          <div>
            <h2 class="text-base font-semibold text-white mb-3">About {app.name}</h2>
            <p class="text-sm text-slate-300 leading-relaxed mb-4">
              {app.description}
            </p>
            {app.detailedDescription && app.detailedDescription.map((p) => (
              <p class="text-sm text-slate-400 leading-relaxed mb-3">
                {p}
              </p>
            ))}
          </div>

          {app.features && app.features.length > 0 && (
            <div>
              <h2 class="text-base font-semibold text-white mb-3">Key Capabilities</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {app.features.map((feat) => (
                  <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.06] flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-brand-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-xs text-slate-300 leading-snug">{feat}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Metadata Sidebar -->
        <div class="space-y-6">
          <div class="p-5 rounded-2xl bg-dark-900/60 border border-white/[0.06] space-y-4">
            <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider">App Information</h3>
            
            <div class="space-y-2.5 text-xs">
              <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                <span class="text-slate-500">Developer</span>
                <span class="text-slate-200 font-medium">{siteConfig.developerName}</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                <span class="text-slate-500">Target Platform</span>
                <span class="text-slate-200 font-medium">Android (Google Play)</span>
              </div>
              {app.version && (
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-slate-500">Status Version</span>
                  <span class="text-slate-200 font-medium font-mono">{app.version}</span>
                </div>
              )}
              <div class="flex justify-between py-1.5">
                <span class="text-slate-500">Privacy Policy</span>
                <a href={app.privacyPolicyUrl} class="text-brand-300 hover:underline">
                  View App Policy
                </a>
              </div>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-brand-500/[0.04] border border-brand-500/15 text-xs text-slate-400 space-y-2">
            <div class="font-semibold text-slate-200">Data & Security</div>
            <p>
              This app is engineered to adhere strictly to the Mahion Labs privacy principles, requesting only the permissions necessary for core utility.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
