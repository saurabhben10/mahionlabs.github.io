---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import AppCard from '../../components/AppCard.astro';
import { siteConfig, formatUrl } from '../../config/site';
---

<BaseLayout
  title="Apps & Products"
  description="Explore the software catalog of Mahion Labs — useful mobile applications, AI utilities, and productivity tools."
>
  <div class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Page Title & Header -->
    <SectionHeader
      eyebrow="Software Studio Portfolio"
      title="Products from Mahion Labs"
      description="We’re building our first generation of applications. New products will appear here as they become available."
    />

    <!-- Coming Soon Banner -->
    <div class="mt-12 max-w-3xl mx-auto">
      <div class="p-6 rounded-2xl bg-brand-500/10 border border-brand-500/20 text-center flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-left">
          <div class="w-10 h-10 rounded-xl bg-brand-500/20 flex items-center justify-center text-brand-300 flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-white">First Generation in Development</h3>
            <p class="text-xs text-slate-400">Our engineering pipeline includes mobile tools for Android and cross-platform utilities.</p>
          </div>
        </div>
        <span class="inline-flex px-3 py-1 text-xs font-semibold text-brand-300 bg-brand-500/20 rounded-full border border-brand-500/30 whitespace-nowrap">
          Pipeline Active
        </span>
      </div>
    </div>

    <!-- Apps Catalog Grid -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {siteConfig.apps.map((app) => (
        <AppCard app={app} featured={true} />
      ))}
    </div>

    <!-- Future App Registry Architecture Note -->
    <div class="mt-20 p-8 rounded-2xl glass-panel border border-white/[0.08] max-w-3xl mx-auto text-center space-y-4">
      <div class="w-10 h-10 rounded-full bg-white/[0.05] border border-white/[0.1] flex items-center justify-center mx-auto text-slate-400">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Continuous Product Deployment</h3>
      <p class="text-sm text-slate-400 leading-relaxed max-w-xl mx-auto">
        Mahion Labs operates as an independent software studio. As new productivity utilities, AI tools, and mobile applications pass internal quality and privacy audits, they are published directly to Google Play and listed on this page.
      </p>
      <div class="pt-2">
        <a href={formatUrl('/support')} class="text-xs font-medium text-brand-300 hover:text-brand-200 transition-colors inline-flex items-center gap-1.5">
          <span>Inquire about beta testing or partnerships</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
